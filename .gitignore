# Логи и резервные копии — никогда не пушим
*.log
*.bak
*.backup
*.dat
*.pid
*.rar
*.zip
*.7z

# Личные/технические
*.user
*dist/

# Сборки — бинарники собираются из исходников, не храним в репо
AutoUpdaterYR.exe
MoonLoaderUninstall.exe

# Бинарники-помощники коммитятся намеренно для скачивания с raw- URLs
# AutoStart.exe, MoonGuard.exe — tracked в корне

# Пользовательские конфиги — привязаны к конкретной машине
*.ini
*.cfg

# Директории с пользовательскими настройками
moonloader/config/
moonloader/AutoLoginByYaroRage/config/
moonloader/CheatByYaroRage/config/
mafk_watchdog/watchdog.log
